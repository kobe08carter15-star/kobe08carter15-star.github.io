// 獲取上限突破數值
function getLimitBreakValue(skillName, level) {
  var table = LIMIT_BREAK_TABLE[skillName];
  if (!table) return 0;
  var lv = Math.max(0, Math.min(10, parseInt(level) || 0));
  return table[lv];
}

